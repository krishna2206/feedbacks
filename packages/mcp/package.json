{
  "name": "@feedbacks/mcp",
  "version": "0.1.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "MCP server of Feedbacks: lets AI agents (Claude Code…) read discussions, triage feedback into tickets and use the knowledge base",
  "keywords": [
    "feedbacks",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "tickets"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/krishna2206/feedbacks",
    "directory": "packages/mcp"
  },
  "bin": {
    "feedbacks-mcp": "dist/stdio.js"
  },
  "exports": {
    ".": "./src/server.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@feedbacks/client": "workspace:*",
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2"
  }
}
