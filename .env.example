# ─────────────────────────────────────────────────────────────────────────────
# Feedbacks configuration. Copy to `.env` (dev: optional, sensible defaults apply).
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the app (web + /api + /sync on the same origin)
APP_URL=http://localhost:5301

# ── Production (docker compose) ─────────────────────────────────────────────
# APP_URL=https://feedbacks.example.com
# POSTGRES_PASSWORD=
# HTTP_PORT=8080

# Postgres (must run with wal_level=logical). In dev, leave unset to use the
# embedded Postgres started by `pnpm dev` (data in .data/postgres, port 5439).
# DATABASE_URL=postgres://feedbacks:feedbacks@localhost:5439/feedbacks

# ── Auth (Better Auth) ───────────────────────────────────────────────────────
# Random 32+ char secret: `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-in-production-please-32chars
# Recommended for any instance reachable from the Internet: the first-run setup (owner account +
# organization) then requires this token, so nobody else can claim the instance before you.
# Open ${APP_URL}/setup?token=<value>. Unused once the instance is set up. `openssl rand -hex 24`
SETUP_TOKEN=
# Optional: "Continue with Google" is shown only when both are set.
# Redirect URI to register: ${APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (optional) ─────────────────────────────────────────────────────────
# Without SMTP, invitation and password-reset links are printed in the API logs
# and owners can copy invitation links from the UI.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Feedbacks <no-reply@example.com>"

# ── Attachments ──────────────────────────────────────────────────────────────
# "local" (default): files on disk (dev: .data/uploads; docker: the uploads volume).
# "s3": any S3-compatible storage (AWS S3, OCI Object Storage, MinIO, Cloudflare R2…).
STORAGE_DRIVER=local
# UPLOADS_DIR=/data/uploads
# S3_ENDPOINT=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
# S3_BUCKET=feedbacks
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# How browsers download S3 attachments: "redirect" (default, presigned URL: the endpoint must be
# reachable from browsers) or "proxy" (streamed by the API: the bucket can stay on a private network)
S3_DOWNLOADS=redirect
# Maximum size of one file, in MB (keep nginx client_max_body_size above it)
UPLOAD_MAX_MB=25
# Uploads never attached to a message (abandoned drafts) are deleted after this delay
UPLOAD_PENDING_TTL_HOURS=24
# Cleanup sweep period, in minutes (0 = no in-process sweep, not even at startup; `pnpm uploads:sweep` still works)
UPLOAD_SWEEP_INTERVAL_MIN=1440
# Trashed folders and documents are deleted for good after this many days (by the same sweep; 0 = never)
DOCS_TRASH_DAYS=30

# ── REST API v1 (agents, CLI, MCP) ──────────────────────────────────────────
# Per access token and per API process: requests per minute, and writes per minute
API_RATE_LIMIT_PER_MIN=300
API_WRITE_RATE_LIMIT_PER_MIN=60

# ── Zero (sync) ──────────────────────────────────────────────────────────────
ZERO_ADMIN_PASSWORD=change-me
# Internal URL zero-cache uses to reach the API (dev default shown)
# ZERO_QUERY_URL=http://localhost:5302/api/zero/query
# ZERO_MUTATE_URL=http://localhost:5302/api/zero/mutate

# ── Dev ports ────────────────────────────────────────────────────────────────
# WEB_PORT=5301
# API_PORT=5302
# ZERO_PORT=4848
# PG_PORT=5439
